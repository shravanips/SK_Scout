   "source": [
    "df[\"created_at\"] = pd.to_datetime(df[\"created_at\"])\n",
    "\n",
    "repo_time = df.groupby(\"repo_name\").agg(\n",
    "    first_event=(\"created_at\", \"min\"),\n",
    "    last_event=(\"created_at\", \"max\"),\n",
    "    total_events=(\"event_id\", \"count\")\n",
    ").reset_index()\n",
    "\n",
    "repo_time[\"time_span_seconds\"] = (\n",
    "    repo_time[\"last_event\"] - repo_time[\"first_event\"]\n",
    ").dt.total_seconds()\n",
    "\n",
    "repo_time[\"events_per_second\"] = repo_time[\"total_events\"] / repo_time[\"time_span_seconds\"].replace(0, 1)"
   ]
  }
