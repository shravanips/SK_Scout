# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env, fill in your values, then load:
#
#   cp .env.example .env
#   export $(grep -v '^#' .env | xargs)
#
# Or with python-dotenv (pip install python-dotenv):
#   from dotenv import load_dotenv; load_dotenv()
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub API ────────────────────────────────────────────────────────────────
# Raises rate limit from 60 → 5 000 req/hr.
# Create at: https://github.com/settings/tokens  (no scopes needed)
GITHUB_TOKEN=ghp_your_token_here

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR  (default: INFO)
LOG_LEVEL=INFO

# ── Data directory override (optional) ────────────────────────────────────────
# Override where data/raw, data/processed, data/runs are written.
# Useful when storing large files on a separate volume.
# DATA_DIR=/path/to/your/data/root
